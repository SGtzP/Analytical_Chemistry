# -*- coding: utf-8 -*-
"""
Titration Fitting Tool for Polyprotic Acids
===========================================

This script fits experimental titration data (pH vs added NaOH volume)
to an n-protic acid model, where n ranges from 1 to 6.

For each n, the model fits:
    - pKa₁, pKa₂, ..., pKaₙ
    - C0 (acid concentration)

The initial acid volume V0 is assumed to be known (e.g., 20 mL).

Author: sgtzp
License: MIT
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import minimize
import os


# ============================================================
# USER SETTINGS
# ============================================================

# User-specified data file (relative path)
DATA_FILE = "DataFitting.xlsx"

# Known constants
C_BASE = 0.1      # NaOH concentration (M)
KW = 1e-14        # Water autodissociation
V0 = 0.020        # Initial acid volume (L) = 20 mL

# Proton range to test
MIN_N = 1
MAX_N = 6


# ============================================================
# LOAD EXPERIMENTAL DATA
# ============================================================

def load_data(filename):
    """
    Load experimental data from an Excel file in the local directory.

    Expected columns:
        Column 0: Added NaOH volume (mL)
        Column 1: pH
    """
    if not os.path.exists(filename):
        raise FileNotFoundError(
            f"Data file '{filename}' not found in current directory:\n{os.getcwd()}"
        )

    df = pd.read_excel(filename)
    V = df.iloc[:, 0].values / 1000.0  # Convert mL → L
    pH = df.iloc[:, 1].values
    return V, pH


V_exp, pH_exp = load_data(DATA_FILE)


# ============================================================
# PLOT EXPERIMENTAL DATA
# ============================================================

def plot_experimental_data(V, pH):
    plt.figure(figsize=(8, 5))
    plt.plot(V * 1000, pH, 'ko-', markersize=4)
    plt.xlabel("Volume NaOH (mL)")
    plt.ylabel("pH")
    plt.title("Experimental Titration Curve")
    plt.grid(True)
    plt.show()


plot_experimental_data(V_exp, pH_exp)


# ============================================================
# GENERAL αᵢ CALCULATION (n-protic acid)
# ============================================================

def alpha_i(H, Ka):
    """
    Compute species fractions α₀ ... αₙ for an n-protic acid.

    Parameters
    ----------
    H : float
        Proton concentration.
    Ka : list of float
        Ka values (length = n).

    Returns
    -------
    numpy array
        Fractional species distribution.
    """
    n = len(Ka)
    numerator = []
    for i in range(n + 1):
        prod_K = np.prod(Ka[:i]) if i > 0 else 1
        numerator.append(prod_K * H ** (n - i))
    denom = sum(numerator)
    return np.array(numerator) / denom


# ============================================================
# FORWARD MODEL: VOLUME AS FUNCTION OF pH
# ============================================================

def volume_from_pH(pH, Ka, C0):
    H = 10**(-pH)
    OH = KW / H
    alpha = alpha_i(H, Ka)

    sum_charge = sum(i * alpha[i] for i in range(1, len(alpha)))

    numerator = V0 * (OH - H + C0 * sum_charge)
    denominator = C_BASE + H - OH

    return numerator / denominator


# ============================================================
# OBJECTIVE FUNCTION
# ============================================================

def objective(params, n, V_exp, pH_exp):
    pKas = params[:-1]
    C0 = params[-1]

    Ka = 10 ** (-np.array(pKas))
    V_model = np.array([volume_from_pH(ph, Ka, C0) for ph in pH_exp])

    return np.nanmean((V_model - V_exp) ** 2)


# ============================================================
# FITTING LOOP
# ============================================================

def fit_acid(V_exp, pH_exp, n_min=1, n_max=6):
    results = []

    for n in range(n_min, n_max + 1):

        print(f"\n=== FITTING n = {n} PROTONS ===\n")

        # Parameter initialization
        pKa_guess = np.linspace(1, 12, n)
        C0_guess = 0.05
        x0 = np.append(pKa_guess, C0_guess)

        bounds = [(0, 14)] * n + [(0.0001, 2.0)]

        res = minimize(
            objective, x0,
            args=(n, V_exp, pH_exp),
            bounds=bounds,
            method="L-BFGS-B"
        )

        best_pKas = res.x[:-1]
        best_C0 = res.x[-1]
        err = res.fun

        print(f"pKa: {best_pKas}")
        print(f"C0 : {best_C0:.4f} M")
        print(f"Error : {err:.6e}")

        results.append({"n": n, "pKa": best_pKas, "C0": best_C0, "error": err})

        # Fit curve
        Ka = 10**(-best_pKas)
        V_fit = np.array([volume_from_pH(ph, Ka, best_C0) for ph in pH_exp])

        plt.figure(figsize=(8, 5))
        plt.plot(V_exp * 1000, pH_exp, 'ko', label="Experimental")
        plt.plot(V_fit * 1000, pH_exp, 'r-', label=f"Fit (n={n})")
        plt.xlabel("Volume NaOH (mL)")
        plt.ylabel("pH")
        plt.title(f"Titration Fit (n={n}, V0 = 20 mL)")
        plt.grid(True)
        plt.legend()
        plt.show()

    return results


results = fit_acid(V_exp, pH_exp, MIN_N, MAX_N)


# ============================================================
# SUMMARY
# ============================================================

print("\n========== SUMMARY OF FITS ==========")
for r in results:
    print(
        f"n={r['n']}: error={r['error']:.6e}, "
        f"C0={r['C0']:.4f}, pKa={r['pKa']}"
    )
